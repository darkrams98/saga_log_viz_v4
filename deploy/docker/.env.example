# =====================================================================
#  متغیرهای استقرار — این فایل را به .env کپی و پر کنید
# =====================================================================
#  ⚠️ .env را در مخزن کد نگذارید. مجوزش را ۶۰۰ بگذارید:
#      cp deploy/docker/.env.example .env && chmod 600 .env
# =====================================================================

# --------------------------------------------------------- پایگاه داده
# کاربر باید فقط نقش `read` داشته باشد — راهنما در docs/07-deployment.md
MONGO_URI=mongodb://log_viewer_ro:CHANGE_ME@db-1.internal:27017,db-2.internal:27017/saga?replicaSet=rs0&authSource=admin&readPreference=secondaryPreferred
MONGO_DB=saga
MONGO_COLLECTION=sagaSequence

# ------------------------------------------------------ صفحهٔ مدیریتی
# با این دستور بسازید:   openssl rand -hex 24
# خالی بگذارید تا صفحهٔ مدیریتی کاملاً غیرفعال بماند (پیش‌فرض امن).
ADMIN_TOKEN=

# ------------------------------------------------------------- شبکه
# فقط روی لوپ‌بک باز می‌شود؛ TLS را پروکسی لبه انجام می‌دهد.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

# ------------------------------------------------------------- سایر
TZ=Asia/Tehran
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC
