# =====================================================================
#  /etc/log-viewer/env
# =====================================================================
#  sudo install -o root -g logviewer -m 640 env.example /etc/log-viewer/env
#
#  ⚠️ رمز اتصال و توکن مدیریتی اینجا هستند. مجوز باید ۶۴۰ باشد و
#     مالک root با گروه logviewer — تا سرویس بخواند ولی کاربران دیگر نه.
# =====================================================================

MONGO_URI=mongodb://log_viewer_ro:CHANGE_ME@db-1.internal:27017,db-2.internal:27017/saga?replicaSet=rs0&authSource=admin&readPreference=secondaryPreferred
MONGO_DB=saga
MONGO_COLLECTION=sagaSequence

# openssl rand -hex 24
# خالی = صفحهٔ مدیریتی غیرفعال
ADMIN_TOKEN=

SERVER_PORT=8080
